<UserControl x:Class="KeyPulse.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock Text="外观" Style="{StaticResource SectionTitleText}"/>
            <Border Style="{StaticResource SectionDivider}"/>

            <DockPanel LastChildFill="True" Margin="0,0,0,8">
                <TextBlock DockPanel.Dock="Left"
                           Text="主题"
                           Style="{StaticResource SettingRowLabel}"
                           Width="72"/>
                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="浅色"
                                 GroupName="Theme"
                                 IsChecked="{Binding IsLightTheme, Mode=TwoWay}"
                                 AutomationProperties.AutomationId="ThemeLight"/>
                    <RadioButton Content="深色"
                                 GroupName="Theme"
                                 IsChecked="{Binding IsDarkTheme, Mode=TwoWay}"
                                 AutomationProperties.AutomationId="ThemeDark"/>
                    <RadioButton Content="跟随系统"
                                 GroupName="Theme"
                                 IsChecked="{Binding IsSystemTheme, Mode=TwoWay}"
                                 AutomationProperties.AutomationId="ThemeSystem"/>
                </StackPanel>
            </DockPanel>

            <TextBlock Text="数据" Style="{StaticResource SectionTitleText}" Margin="0,28,0,0"/>
            <Border Style="{StaticResource SectionDivider}"/>

            <TextBlock Text="数据位置" Style="{StaticResource SettingRowLabel}" Margin="0,0,0,6"/>
            <TextBox Text="{Binding DataPath, Mode=OneWay}"
                     Style="{StaticResource ReadOnlyPathBox}"
                     AutomationProperties.AutomationId="DataPathText"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
