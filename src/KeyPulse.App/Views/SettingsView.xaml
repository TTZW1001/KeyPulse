<UserControl x:Class="KeyPulse.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <ScrollViewer Style="{StaticResource PageScrollViewer}">
        <StackPanel MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock Text="常规" Style="{StaticResource SectionTitleText}"/>
            <Border Style="{StaticResource SectionDivider}"/>

            <CheckBox Content="开机自动启动"
                      IsChecked="{Binding StartupEnabled, Mode=TwoWay}"
                      AutomationProperties.AutomationId="StartupEnabled"/>
            <CheckBox Content="启动后最小化到托盘"
                      IsChecked="{Binding StartMinimized, Mode=OneWay}"
                      IsEnabled="False"
                      AutomationProperties.AutomationId="StartMinimized"/>
            <TextBlock Text="自启命令带 --startup，不弹出主窗口。"
                       Style="{StaticResource SecondaryText}"
                       Margin="22,0,0,4"/>

            <TextBlock Text="外观" Style="{StaticResource SectionTitleText}" Margin="0,28,0,0"/>
            <Border Style="{StaticResource SectionDivider}"/>

            <DockPanel LastChildFill="True" Margin="0,0,0,8">
                <TextBlock DockPanel.Dock="Left"
                           Text="主题"
                           Style="{StaticResource SettingRowLabel}"
                           Width="72"/>
                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="浅色"
                                 GroupName="Theme"
                                 IsChecked="{Binding IsLightTheme, Mode=TwoWay}"
                                 AutomationProperties.AutomationId="ThemeLight"/>
                    <RadioButton Content="深色"
                                 GroupName="Theme"
                                 IsChecked="{Binding IsDarkTheme, Mode=TwoWay}"
                                 AutomationProperties.AutomationId="ThemeDark"/>
                    <RadioButton Content="跟随系统"
                                 GroupName="Theme"
                                 IsChecked="{Binding IsSystemTheme, Mode=TwoWay}"
                                 AutomationProperties.AutomationId="ThemeSystem"/>
                </StackPanel>
            </DockPanel>

            <TextBlock Text="隐私与统计" Style="{StaticResource SectionTitleText}" Margin="0,28,0,0"/>
            <Border Style="{StaticResource SectionDivider}"/>
            <CheckBox Content="统计快捷键组合（仅保存组合名称与累计次数）"
                      IsChecked="{Binding ShortcutStatsEnabled, Mode=TwoWay}"
                      AutomationProperties.AutomationId="ShortcutStatsEnabled"/>
            <CheckBox Content="记录屏幕位置热力图"
                      IsChecked="{Binding ScreenPositionStatsEnabled, Mode=TwoWay}"
                      AutomationProperties.AutomationId="ScreenPositionStatsEnabled"/>
            <CheckBox Content="在总览显示今日小结和个人纪录"
                      IsChecked="{Binding ShowInsights, Mode=TwoWay}"/>
            <TextBlock Text="只保存本机坐标统计，不截屏，不记录窗口名称或输入内容。"
                       Style="{StaticResource SecondaryText}" Margin="22,0,0,8" TextWrapping="Wrap"/>
            <TextBlock Text="输入诊断" Style="{StaticResource SectionTitleText}" Margin="0,28,0,0"/>
            <Border Style="{StaticResource SectionDivider}"/>
            <CheckBox Content="临时显示原始键盘事件"
                      IsChecked="{Binding InputDiagnosticsEnabled, Mode=TwoWay}"
                      AutomationProperties.AutomationId="InputDiagnosticsEnabled"/>
            <TextBlock Text="仅在内存显示最近 16 条键名、键码和修饰键状态；不写数据库、不写日志，关闭后立即清空。测试时请勿输入密码。"
                       Style="{StaticResource SecondaryText}" Margin="22,0,0,8" TextWrapping="Wrap"/>
            <Border Visibility="{Binding InputDiagnosticsEnabled, Converter={StaticResource BoolToVis}}"
                    Background="{DynamicResource ControlBackgroundBrush}"
                    BorderBrush="{DynamicResource ControlBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12"
                    Margin="0,4,0,0">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right"
                                Content="清空"
                                Style="{StaticResource QuietButton}"
                                Command="{Binding ClearInputDiagnosticsCommand}"
                                AutomationProperties.AutomationId="ClearInputDiagnosticsButton"/>
                        <TextBlock Text="最新事件在上方"
                                   Style="{StaticResource SecondaryText}"
                                   VerticalAlignment="Center"/>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding InputDiagnosticRows}"
                                  AutomationProperties.AutomationId="InputDiagnosticRows">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                           FontFamily="Consolas"
                                           FontSize="12"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,2"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <TextBlock Text="排除应用" Style="{StaticResource SectionTitleText}" Margin="0,28,0,0"/>
            <Border Style="{StaticResource SectionDivider}"/>
            <TextBlock Text="按进程名排除。不保存完整路径。默认项不可删除。"
                       Style="{StaticResource SecondaryText}"
                       Margin="0,0,0,8"/>

            <ItemsControl ItemsSource="{Binding ExcludedApps}"
                          AutomationProperties.AutomationId="ExcludedList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="0,0,0,6" LastChildFill="True">
                            <Button DockPanel.Dock="Right"
                                    Content="移除"
                                    Command="{Binding DataContext.RemoveExcludedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    IsEnabled="{Binding CanRemove}"
                                    MinWidth="56"
                                    Padding="8,2"
                                    MinHeight="24"
                                    AutomationProperties.AutomationId="ExcludeRemove"/>
                            <TextBlock DockPanel.Dock="Right"
                                       Text="{Binding StatusText}"
                                       Style="{StaticResource SecondaryText}"
                                       Margin="12,0"
                                       VerticalAlignment="Center"
                                       Width="36"/>
                            <TextBlock Text="{Binding ProcessName}"
                                       Style="{StaticResource BodyText}"
                                       VerticalAlignment="Center"/>
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <DockPanel Margin="0,8,0,0" LastChildFill="True">
                <Button DockPanel.Dock="Right"
                        Content="浏览"
                        Command="{Binding BrowseExcludedCommand}"
                        Margin="8,0,0,0"
                        AutomationProperties.AutomationId="ExcludeBrowse"/>
                <Button DockPanel.Dock="Right"
                        Content="添加"
                        Command="{Binding AddExcludedCommand}"
                        AutomationProperties.AutomationId="ExcludeAdd"/>
                <TextBox Text="{Binding NewProcessName, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource SettingInputBox}"
                         Margin="0,0,8,0"
                         AutomationProperties.AutomationId="ExcludeAddBox">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding AddExcludedCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>
            </DockPanel>

            <TextBlock Text="数据" Style="{StaticResource SectionTitleText}" Margin="0,28,0,0"/>
            <Border Style="{StaticResource SectionDivider}"/>

            <TextBlock Text="数据位置" Style="{StaticResource SettingRowLabel}" Margin="0,0,0,6"/>
            <TextBox Text="{Binding DataPath, Mode=OneWay}"
                     Style="{StaticResource ReadOnlyPathBox}"
                     AutomationProperties.AutomationId="DataPathText"/>
            <TextBlock Text="约每 5 分钟写入磁盘；退出、休眠和导出前会立即保存。暂不支持按 AFK 自动暂停。"
                       Style="{StaticResource SecondaryText}"
                       Margin="0,8,0,12"/>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="数据库" Style="{StaticResource SecondaryText}"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DatabasePath}" TextWrapping="Wrap"/>
                <TextBlock Grid.Row="1" Text="占用空间" Style="{StaticResource SecondaryText}"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DatabaseSizeText}"/>
                <TextBlock Grid.Row="2" Text="数据日期" Style="{StaticResource SecondaryText}"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DateRangeText}"/>
                <TextBlock Grid.Row="3" Text="最近写入 / 状态" Style="{StaticResource SecondaryText}"/>
                <TextBlock Grid.Row="3" Grid.Column="1">
                    <Run Text="{Binding LastFlushText}"/><Run Text=" · "/><Run Text="{Binding WriteHealthText}"/>
                </TextBlock>
            </Grid>

            <TextBlock Text="位置明细保留" Style="{StaticResource SettingRowLabel}" Margin="0,0,0,6"/>
            <WrapPanel Margin="0,0,0,8">
                <RadioButton Content="30 天" GroupName="Retention" IsChecked="{Binding IsRetention30Days, Mode=TwoWay}"/>
                <RadioButton Content="90 天" GroupName="Retention" IsChecked="{Binding IsRetention90Days, Mode=TwoWay}"/>
                <RadioButton Content="1 年" GroupName="Retention" IsChecked="{Binding IsRetention365Days, Mode=TwoWay}"/>
                <RadioButton Content="永久" GroupName="Retention" Margin="0" IsChecked="{Binding IsRetentionForever, Mode=TwoWay}"/>
            </WrapPanel>
            <TextBlock Text="只清理点击散点和轨迹密度历史；累计像素覆盖不会自动删除，可用“清除位置数据”重置。"
                       Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,0,0,12"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Button Content="导出 CSV"
                        Command="{Binding ExportCommand}"
                        AutomationProperties.AutomationId="ExportButton"/>
                <Button Content="备份" Command="{Binding BackupCommand}" Margin="12,0,0,0"/>
                <Button Content="恢复" Command="{Binding RestoreCommand}" Margin="12,0,0,0"/>
                <Button Content="整理空间" Command="{Binding VacuumCommand}" Margin="12,0,0,0"/>
                <Button Content="清空统计数据"
                        Command="{Binding ClearStatsCommand}"
                        Style="{StaticResource DangerButton}"
                        Margin="12,0,0,0"
                        AutomationProperties.AutomationId="ClearStatsButton"/>
            </StackPanel>
            <WrapPanel Margin="0,0,0,8">
                <Button Content="清除今天" Command="{Binding ClearRangeCommand}" CommandParameter="today"/>
                <Button Content="清除最近 30 天" Command="{Binding ClearRangeCommand}" CommandParameter="30days" Margin="12,0,0,0"/>
                <Button Content="清除位置数据" Command="{Binding ClearPositionDataCommand}" Margin="12,0,0,0"/>
            </WrapPanel>
            <TextBlock Text="{Binding DataStatus}"
                       Style="{StaticResource SecondaryText}"
                       AutomationProperties.AutomationId="DataStatus"/>

            <TextBlock Text="关于" Style="{StaticResource SectionTitleText}" Margin="0,28,0,0"/>
            <Border Style="{StaticResource SectionDivider}"/>
            <TextBlock Text="{Binding ProductName}"
                       Style="{StaticResource BodyText}"
                       AutomationProperties.AutomationId="AboutName"/>
            <TextBlock Text="{Binding VersionText}"
                       Style="{StaticResource SecondaryText}"
                       Margin="0,4,0,0"
                       AutomationProperties.AutomationId="AboutVersion"/>
            <TextBlock Text="{Binding PrivacyNotice}"
                       Style="{StaticResource SecondaryText}"
                       Margin="0,4,0,0"
                       AutomationProperties.AutomationId="AboutPrivacy"/>
            <TextBlock Text="{Binding DataRoot, StringFormat=数据位置：{0}}"
                       Style="{StaticResource SecondaryText}"
                       Margin="0,4,0,8"
                       AutomationProperties.AutomationId="AboutDataRoot"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
