<UserControl x:Class="KeyPulse.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <TextBlock Text="今日" Style="{StaticResource SecondaryText}" Margin="0,0,0,12"/>
            <Border Style="{StaticResource SectionDivider}" Padding="0,0,0,20" Margin="0,0,0,24">
                <UniformGrid Columns="4">
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="{Binding KeyCountText}"
                                   Style="{StaticResource MetricValue}"
                                   AutomationProperties.AutomationId="MetricKeys"/>
                        <TextBlock Text="次按键" Style="{StaticResource MetricLabel}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="{Binding ClickCountText}"
                                   Style="{StaticResource MetricValue}"
                                   AutomationProperties.AutomationId="MetricClicks"/>
                        <TextBlock Text="次点击" Style="{StaticResource MetricLabel}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="{Binding WheelCountText}"
                                   Style="{StaticResource MetricValue}"
                                   AutomationProperties.AutomationId="MetricWheel"/>
                        <TextBlock Text="次滚轮" Style="{StaticResource MetricLabel}"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{Binding DistanceText}"
                                   Style="{StaticResource MetricValue}"
                                   AutomationProperties.AutomationId="MetricDistance"/>
                        <TextBlock Text="鼠标移动" Style="{StaticResource MetricLabel}"/>
                    </StackPanel>
                </UniformGrid>
            </Border>

            <TextBlock Text="状态" Style="{StaticResource SecondaryText}" Margin="0,0,0,6"/>
            <TextBlock Text="{Binding StatusText}"
                       Style="{StaticResource BodyText}"
                       AutomationProperties.AutomationId="DashboardStatus"/>

            <TextBlock Text="暂时还没有图表"
                       Style="{StaticResource PlaceholderTitle}"
                       Margin="0,32,0,0"/>
            <TextBlock Text="统计数据会在后续阶段接到这里。"
                       Style="{StaticResource PlaceholderBody}"
                       Margin="0,8,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
