<UserControl x:Class="KeyPulse.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">
    <ScrollViewer Style="{StaticResource PageScrollViewer}">
        <StackPanel>
            <TextBlock Text="今日" Style="{StaticResource SecondaryText}" Margin="0,0,0,12"/>
            <Border Style="{StaticResource SectionDivider}" Padding="0,0,0,20" Margin="0,0,0,20">
                <UniformGrid Columns="4">
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="{Binding KeyCountText}"
                                   Style="{StaticResource MetricValue}"
                                   AutomationProperties.AutomationId="MetricKeys"/>
                        <TextBlock Text="次按键" Style="{StaticResource MetricLabel}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="{Binding ClickCountText}"
                                   Style="{StaticResource MetricValue}"
                                   AutomationProperties.AutomationId="MetricClicks"/>
                        <TextBlock Text="次点击" Style="{StaticResource MetricLabel}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="{Binding WheelCountText}"
                                   Style="{StaticResource MetricValue}"
                                   AutomationProperties.AutomationId="MetricWheel"/>
                        <TextBlock Text="次滚轮" Style="{StaticResource MetricLabel}"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{Binding DistanceText}"
                                   Style="{StaticResource MetricValue}"
                                   AutomationProperties.AutomationId="MetricDistance"/>
                        <TextBlock Text="鼠标移动" Style="{StaticResource MetricLabel}"/>
                    </StackPanel>
                </UniformGrid>
            </Border>

            <DockPanel Margin="0,0,0,20">
                <TextBlock DockPanel.Dock="Left"
                           Text="最常用按键"
                           Style="{StaticResource SecondaryText}"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"/>
                <TextBlock Text="{Binding MostUsedText}"
                           Style="{StaticResource BodyText}"
                           VerticalAlignment="Center"
                           AutomationProperties.AutomationId="MostUsedKey"/>
            </DockPanel>

            <TextBlock Text="最近 7 天活动趋势" Style="{StaticResource SectionTitleText}"/>
            <Border Style="{StaticResource SectionDivider}"/>
            <lvc:CartesianChart Height="176"
                                Margin="0,0,0,8"
                                Series="{Binding TrendSeries}"
                                XAxes="{Binding TrendXAxes}"
                                YAxes="{Binding TrendYAxes}"
                                LegendPosition="Hidden"
                                TooltipPosition="Top"
                                ZoomMode="None"
                                AnimationsSpeed="0:0:0"
                                Background="Transparent"
                                AutomationProperties.AutomationId="TrendChart"/>

            <TextBlock Text="今日活跃时段" Style="{StaticResource SectionTitleText}" Margin="0,16,0,0"/>
            <Border Style="{StaticResource SectionDivider}"/>
            <lvc:CartesianChart Height="160"
                                Margin="0,0,0,8"
                                Series="{Binding HourlySeries}"
                                XAxes="{Binding HourlyXAxes}"
                                YAxes="{Binding HourlyYAxes}"
                                LegendPosition="Hidden"
                                TooltipPosition="Top"
                                ZoomMode="None"
                                AnimationsSpeed="0:0:0"
                                Background="Transparent"
                                AutomationProperties.AutomationId="HourlyChart"/>

            <TextBlock Text="状态" Style="{StaticResource SecondaryText}" Margin="0,16,0,6"/>
            <TextBlock Text="{Binding StatusText}"
                       Style="{StaticResource BodyText}"
                       AutomationProperties.AutomationId="DashboardStatus"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
