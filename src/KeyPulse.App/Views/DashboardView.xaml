<UserControl x:Class="KeyPulse.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">
    <UserControl.Resources><BooleanToVisibilityConverter x:Key="BoolToVis"/></UserControl.Resources>
    <ScrollViewer Style="{StaticResource PageScrollViewer}">
        <StackPanel>
            <TextBlock Text="今日" Style="{StaticResource SecondaryText}" Margin="0,0,0,12"/>
            <Border Style="{StaticResource SectionDivider}" Padding="0,0,0,20" Margin="0,0,0,20">
                <UniformGrid Columns="4">
                    <StackPanel Margin="0,0,16,0" ToolTip="统计按键按下次数；组合键中的每个按键仍分别计数。">
                        <TextBlock Text="{Binding KeyCountText}"
                                   Style="{StaticResource MetricValue}"
                                   AutomationProperties.AutomationId="MetricKeys"/>
                        <TextBlock Text="次按键" Style="{StaticResource MetricLabel}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,16,0" ToolTip="仅统计在系统拖拽阈值内完成按下与松开的点击；拖拽不计入。">
                        <TextBlock Text="{Binding ClickCountText}"
                                   Style="{StaticResource MetricValue}"
                                   AutomationProperties.AutomationId="MetricClicks"/>
                        <TextBlock Text="次点击" Style="{StaticResource MetricLabel}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,16,0" ToolTip="按收到的垂直或水平滚轮事件计数，不等同于滚动像素。">
                        <TextBlock Text="{Binding WheelCountText}"
                                   Style="{StaticResource MetricValue}"
                                   AutomationProperties.AutomationId="MetricWheel"/>
                        <TextBlock Text="次滚轮" Style="{StaticResource MetricLabel}"/>
                    </StackPanel>
                    <StackPanel ToolTip="像素距离来自系统光标坐标；物理距离按显示器 DPI 估算。">
                        <TextBlock Text="{Binding DistanceText}"
                                   Style="{StaticResource MetricValue}"
                                   AutomationProperties.AutomationId="MetricDistance"/>
                        <TextBlock Text="鼠标移动" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding DistanceEstimateText}" Style="{StaticResource SecondaryText}" FontSize="11"/>
                    </StackPanel>
                </UniformGrid>
            </Border>

            <Border Background="{DynamicResource ControlBackgroundBrush}"
                    BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="16" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="今日有效使用" Style="{StaticResource SecondaryText}"/>
                        <TextBlock Text="{Binding EffectiveTimeText}" Style="{StaticResource MetricValue}" FontSize="24"/>
                        <TextBlock Text="{Binding EffectiveTimeHint}" Style="{StaticResource SecondaryText}" FontSize="11"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="活动会话" Style="{StaticResource SecondaryText}"/>
                        <TextBlock Text="{Binding SessionCountText}" Style="{StaticResource MetricValue}" FontSize="24"/>
                        <TextBlock Text="连续 15 分钟无输入后分为新会话" Style="{StaticResource SecondaryText}" FontSize="11"/>
                    </StackPanel>
                </Grid>
            </Border>

            <DockPanel Margin="0,0,0,20">
                <TextBlock DockPanel.Dock="Left"
                           Text="最常用按键"
                           Style="{StaticResource SecondaryText}"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"/>
                <TextBlock Text="{Binding MostUsedText}"
                           Style="{StaticResource BodyText}"
                           VerticalAlignment="Center"
                           AutomationProperties.AutomationId="MostUsedKey"/>
            </DockPanel>

            <StackPanel Visibility="{Binding ShowInsights, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="今日小结" Style="{StaticResource SectionTitleText}"/>
            <Border Style="{StaticResource SectionDivider}"/>
            <UniformGrid Columns="2" Margin="0,0,0,20">
                <StackPanel Margin="0,0,20,12">
                    <TextBlock Text="最活跃时段" Style="{StaticResource SecondaryText}"/>
                    <TextBlock Text="{Binding PeakHourText}" Style="{StaticResource BodyText}" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="最常用快捷键" Style="{StaticResource SecondaryText}"/>
                    <TextBlock Text="{Binding TopShortcutText}" Style="{StaticResource BodyText}" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Margin="0,0,20,0">
                    <TextBlock Text="前台时间最长" Style="{StaticResource SecondaryText}"/>
                    <TextBlock Text="{Binding TopAppText}" Style="{StaticResource BodyText}" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="相对历史 / 个人纪录" Style="{StaticResource SecondaryText}"/>
                    <TextBlock Text="{Binding ComparisonText}" Style="{StaticResource BodyText}"/>
                    <TextBlock Text="{Binding RecordText}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap"/>
                </StackPanel>
            </UniformGrid>
            </StackPanel>

            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="最近 7 天活动趋势" Style="{StaticResource SectionTitleText}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <RadioButton Content="按键" GroupName="DashboardTrend"
                                 IsChecked="{Binding IsKeysTrend, Mode=TwoWay}"/>
                    <RadioButton Content="点击" GroupName="DashboardTrend"
                                 IsChecked="{Binding IsClicksTrend, Mode=TwoWay}"/>
                    <RadioButton Content="滚轮" GroupName="DashboardTrend" Margin="0"
                                 IsChecked="{Binding IsWheelTrend, Mode=TwoWay}"/>
                </StackPanel>
            </Grid>
            <Border Style="{StaticResource SectionDivider}"/>
            <lvc:CartesianChart Height="176"
                                Margin="0,0,0,8"
                                Series="{Binding TrendSeries}"
                                XAxes="{Binding TrendXAxes}"
                                YAxes="{Binding TrendYAxes}"
                                LegendPosition="Hidden"
                                TooltipPosition="Top"
                                ZoomMode="None"
                                AnimationsSpeed="0:0:0"
                                Background="Transparent"
                                ChartPointPointerDownCommand="{Binding OpenTrendDetailCommand}"
                                AutomationProperties.AutomationId="TrendChart"/>
            <Button Content="查看今天的趋势详情"
                    Command="{Binding OpenTrendDetailCommand}"
                    HorizontalAlignment="Left"
                    Margin="0,2,0,8"
                    AutomationProperties.HelpText="与点击趋势图数据点进入详情的操作相同"/>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="今日活跃时段" Style="{StaticResource SectionTitleText}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="#4E6E9E" Margin="0,0,6,0"/>
                    <TextBlock Text="键盘" Style="{StaticResource SecondaryText}" Margin="0,0,16,0"/>
                    <Ellipse Width="8" Height="8" Fill="#5F9998" Margin="0,0,6,0"/>
                    <TextBlock Text="点击" Style="{StaticResource SecondaryText}" Margin="0,0,16,0"/>
                    <Ellipse Width="8" Height="8" Fill="#A7B3C5" Margin="0,0,6,0"/>
                    <TextBlock Text="滚轮" Style="{StaticResource SecondaryText}"/>
                </StackPanel>
            </Grid>
            <Border Style="{StaticResource SectionDivider}"/>
            <lvc:CartesianChart Height="160"
                                Margin="0,0,0,8"
                                Series="{Binding HourlySeries}"
                                XAxes="{Binding HourlyXAxes}"
                                YAxes="{Binding HourlyYAxes}"
                                LegendPosition="Hidden"
                                TooltipPosition="Top"
                                ZoomMode="None"
                                AnimationsSpeed="0:0:0"
                                Background="Transparent"
                                ChartPointPointerDownCommand="{Binding OpenHourlyDetailCommand}"
                                AutomationProperties.AutomationId="HourlyChart"/>

            <TextBlock Text="状态" Style="{StaticResource SecondaryText}" Margin="0,16,0,6"/>
            <TextBlock Text="{Binding StatusText}"
                       Style="{StaticResource BodyText}"
                       AutomationProperties.AutomationId="DashboardStatus"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock Text="{Binding DataStateText}" Style="{StaticResource SecondaryText}" VerticalAlignment="Center"/>
                <Button Content="刷新" Command="{Binding RetryCommand}" Margin="12,0,0,0"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
