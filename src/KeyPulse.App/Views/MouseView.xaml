<UserControl x:Class="KeyPulse.App.Views.MouseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <DockPanel Margin="0,0,0,16">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <RadioButton Content="今天"
                                 GroupName="MouseRange"
                                 IsChecked="{Binding IsTodayRange, Mode=TwoWay}"
                                 AutomationProperties.AutomationId="MouseToday"/>
                    <RadioButton Content="最近 7 天"
                                 GroupName="MouseRange"
                                 IsChecked="{Binding IsLast7DaysRange, Mode=TwoWay}"
                                 AutomationProperties.AutomationId="MouseLast7"/>
                </StackPanel>
                <TextBlock Text="鼠标使用" Style="{StaticResource SecondaryText}" VerticalAlignment="Center"/>
            </DockPanel>

            <Border Style="{StaticResource SectionDivider}" Padding="0,0,0,16" Margin="0,0,0,16">
                <StackPanel>
                    <UniformGrid Columns="3" Margin="0,0,0,12">
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="{Binding LeftText}" Style="{StaticResource MetricValue}"
                                       AutomationProperties.AutomationId="MouseLeft"/>
                            <TextBlock Text="左键" Style="{StaticResource MetricLabel}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="{Binding RightText}" Style="{StaticResource MetricValue}"
                                       AutomationProperties.AutomationId="MouseRight"/>
                            <TextBlock Text="右键" Style="{StaticResource MetricLabel}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{Binding MiddleText}" Style="{StaticResource MetricValue}"
                                       AutomationProperties.AutomationId="MouseMiddle"/>
                            <TextBlock Text="中键" Style="{StaticResource MetricLabel}"/>
                        </StackPanel>
                    </UniformGrid>
                    <UniformGrid Columns="2"
                                 Margin="0,0,0,12"
                                 Visibility="{Binding ShowXButtons, Converter={StaticResource BoolToVis}}">
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="{Binding X1Text}" Style="{StaticResource MetricValue}"
                                       AutomationProperties.AutomationId="MouseX1"/>
                            <TextBlock Text="X1" Style="{StaticResource MetricLabel}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{Binding X2Text}" Style="{StaticResource MetricValue}"
                                       AutomationProperties.AutomationId="MouseX2"/>
                            <TextBlock Text="X2" Style="{StaticResource MetricLabel}"/>
                        </StackPanel>
                    </UniformGrid>
                    <UniformGrid Columns="2">
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="{Binding WheelUpText}" Style="{StaticResource MetricValue}"
                                       AutomationProperties.AutomationId="MouseWheelUp"/>
                            <TextBlock Text="滚轮上" Style="{StaticResource MetricLabel}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{Binding WheelDownText}" Style="{StaticResource MetricValue}"
                                       AutomationProperties.AutomationId="MouseWheelDown"/>
                            <TextBlock Text="滚轮下" Style="{StaticResource MetricLabel}"/>
                        </StackPanel>
                    </UniformGrid>
                    <UniformGrid Columns="2"
                                 Margin="0,12,0,0"
                                 Visibility="{Binding ShowHorizontalWheel, Converter={StaticResource BoolToVis}}">
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="{Binding WheelLeftText}" Style="{StaticResource MetricValue}"/>
                            <TextBlock Text="滚轮左" Style="{StaticResource MetricLabel}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{Binding WheelRightText}" Style="{StaticResource MetricValue}"/>
                            <TextBlock Text="滚轮右" Style="{StaticResource MetricLabel}"/>
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <TextBlock Text="移动距离" Style="{StaticResource SecondaryText}" Margin="0,0,0,6"/>
            <TextBlock Text="{Binding DistancePixelsText}"
                       Style="{StaticResource MetricValue}"
                       AutomationProperties.AutomationId="MouseDistancePx"/>
            <TextBlock Text="{Binding DistanceConvertedText}"
                       Style="{StaticResource SecondaryText}"
                       Margin="0,4,0,0"
                       Visibility="{Binding HasConvertedDistance, Converter={StaticResource BoolToVis}}"
                       AutomationProperties.AutomationId="MouseDistanceConverted"/>

            <TextBlock Text="左 / 右 / 中占比" Style="{StaticResource SecondaryText}" Margin="0,20,0,8"/>
            <StackPanel>
                <DockPanel Margin="0,0,0,8">
                    <TextBlock DockPanel.Dock="Left" Width="36" Text="左" Style="{StaticResource BodyText}"/>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding LeftShareText}"
                               Style="{StaticResource SecondaryText}"
                               AutomationProperties.AutomationId="MouseLeftShare"/>
                    <Grid Height="8" Margin="8,0" VerticalAlignment="Center">
                        <Border Background="{DynamicResource DividerBrush}" CornerRadius="2"/>
                        <Border Width="{Binding LeftShareWidth}"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource AccentBrush}"
                                CornerRadius="2"/>
                    </Grid>
                </DockPanel>
                <DockPanel Margin="0,0,0,8">
                    <TextBlock DockPanel.Dock="Left" Width="36" Text="右" Style="{StaticResource BodyText}"/>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding RightShareText}" Style="{StaticResource SecondaryText}"/>
                    <Grid Height="8" Margin="8,0" VerticalAlignment="Center">
                        <Border Background="{DynamicResource DividerBrush}" CornerRadius="2"/>
                        <Border Width="{Binding RightShareWidth}"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource AccentBrush}"
                                CornerRadius="2"/>
                    </Grid>
                </DockPanel>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Width="36" Text="中" Style="{StaticResource BodyText}"/>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding MiddleShareText}" Style="{StaticResource SecondaryText}"/>
                    <Grid Height="8" Margin="8,0" VerticalAlignment="Center">
                        <Border Background="{DynamicResource DividerBrush}" CornerRadius="2"/>
                        <Border Width="{Binding MiddleShareWidth}"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource AccentBrush}"
                                CornerRadius="2"/>
                    </Grid>
                </DockPanel>
            </StackPanel>

            <TextBlock Text="最近 7 天鼠标活动" Style="{StaticResource SectionTitleText}" Margin="0,24,0,0"/>
            <Border Style="{StaticResource SectionDivider}"/>
            <lvc:CartesianChart Height="176"
                                Series="{Binding TrendSeries}"
                                XAxes="{Binding TrendXAxes}"
                                YAxes="{Binding TrendYAxes}"
                                LegendPosition="Hidden"
                                TooltipPosition="Top"
                                ZoomMode="None"
                                AnimationsSpeed="0:0:0"
                                Background="Transparent"
                                AutomationProperties.AutomationId="MouseTrendChart"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
