<UserControl x:Class="KeyPulse.App.Views.MouseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">
    <UserControl.Resources><BooleanToVisibilityConverter x:Key="BoolToVis"/></UserControl.Resources>
    <ScrollViewer Style="{StaticResource PageScrollViewer}">
        <StackPanel>
            <DockPanel Margin="0,0,0,18">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <RadioButton Content="今天" GroupName="MouseRange" IsChecked="{Binding IsTodayRange, Mode=TwoWay}"/>
                    <RadioButton Content="最近 7 天" GroupName="MouseRange" IsChecked="{Binding IsLast7DaysRange, Mode=TwoWay}"/>
                    <RadioButton Content="最近 30 天" GroupName="MouseRange" IsChecked="{Binding IsLast30DaysRange, Mode=TwoWay}"/>
                    <RadioButton Content="全部" GroupName="MouseRange" Margin="0" IsChecked="{Binding IsAllRange, Mode=TwoWay}"/>
                </StackPanel>
                <TextBlock Text="鼠标使用" Style="{StaticResource SecondaryText}"/>
            </DockPanel>

            <UniformGrid Columns="3" Margin="0,0,0,22">
                <StackPanel><TextBlock Text="{Binding TotalClicksText}" Style="{StaticResource MetricValue}"/><TextBlock Text="总点击" Style="{StaticResource MetricLabel}"/></StackPanel>
                <StackPanel><TextBlock Text="{Binding TotalScrollText}" Style="{StaticResource MetricValue}"/><TextBlock Text="总滚动" Style="{StaticResource MetricLabel}"/></StackPanel>
                <StackPanel>
                    <TextBlock Text="{Binding DistancePixelsText}" Style="{StaticResource MetricValue}"/>
                    <TextBlock Text="屏幕光标距离" Style="{StaticResource MetricLabel}"/>
                    <TextBlock Text="{Binding DistanceConvertedText}" Style="{StaticResource SecondaryText}"
                               Visibility="{Binding HasConvertedDistance, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </UniformGrid>

            <Grid Margin="0,0,0,22">
                <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="按键热力图" Style="{StaticResource SectionTitleText}" Margin="0,0,0,12"/>
                    <Grid Width="190" Height="250" HorizontalAlignment="Left">
                        <Border Background="{DynamicResource ContentBackgroundBrush}" BorderBrush="{DynamicResource DividerBrush}"
                                BorderThickness="2" CornerRadius="70,70,62,62"/>
                        <Grid Margin="17,18,17,104">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="3"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{Binding LeftHeatBrush}" CornerRadius="50,0,8,8"
                                    ToolTip="{Binding LeftText, StringFormat=左键 · {0} 次}"/>
                            <Border Grid.Column="2" Background="{Binding RightHeatBrush}" CornerRadius="0,50,8,8"
                                    ToolTip="{Binding RightText, StringFormat=右键 · {0} 次}"/>
                        </Grid>
                        <Border Width="20" Height="54" VerticalAlignment="Top" Margin="0,28,0,0"
                                Background="{Binding MiddleHeatBrush}" BorderBrush="{DynamicResource DividerBrush}"
                                BorderThickness="1" CornerRadius="8" ToolTip="{Binding MiddleText, StringFormat=中键 · {0} 次}"/>
                        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-8,20,0,0">
                            <Border Width="24" Height="42" Margin="0,0,0,5" Background="{Binding X1HeatBrush}"
                                    BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="5"
                                    ToolTip="{Binding X1Text, StringFormat=X1 · {0} 次}"/>
                            <Border Width="24" Height="42" Background="{Binding X2HeatBrush}"
                                    BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="5"
                                    ToolTip="{Binding X2Text, StringFormat=X2 · {0} 次}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="按键明细" Style="{StaticResource SectionTitleText}" Margin="0,0,0,12"/>
                    <UniformGrid Columns="3" Margin="0,0,0,16">
                        <StackPanel><TextBlock Text="{Binding LeftText}" Style="{StaticResource MetricValue}"/><TextBlock Text="左键" Style="{StaticResource MetricLabel}"/></StackPanel>
                        <StackPanel><TextBlock Text="{Binding RightText}" Style="{StaticResource MetricValue}"/><TextBlock Text="右键" Style="{StaticResource MetricLabel}"/></StackPanel>
                        <StackPanel><TextBlock Text="{Binding MiddleText}" Style="{StaticResource MetricValue}"/><TextBlock Text="中键" Style="{StaticResource MetricLabel}"/></StackPanel>
                    </UniformGrid>
                    <UniformGrid Columns="2" Visibility="{Binding ShowXButtons, Converter={StaticResource BoolToVis}}">
                        <StackPanel><TextBlock Text="{Binding X1Text}" Style="{StaticResource BodyText}"/><TextBlock Text="侧键 X1" Style="{StaticResource MetricLabel}"/></StackPanel>
                        <StackPanel><TextBlock Text="{Binding X2Text}" Style="{StaticResource BodyText}"/><TextBlock Text="侧键 X2" Style="{StaticResource MetricLabel}"/></StackPanel>
                    </UniformGrid>

                    <TextBlock Text="滚轮明细" Style="{StaticResource SectionTitleText}" Margin="0,22,0,10"/>
                    <UniformGrid Columns="2">
                        <DockPanel Margin="0,3,20,3"><TextBlock DockPanel.Dock="Right" Text="{Binding WheelUpText}"/><TextBlock Text="向上滚动" Style="{StaticResource SecondaryText}"/></DockPanel>
                        <DockPanel Margin="0,3"><TextBlock DockPanel.Dock="Right" Text="{Binding WheelDownText}"/><TextBlock Text="向下滚动" Style="{StaticResource SecondaryText}"/></DockPanel>
                    </UniformGrid>
                    <UniformGrid Columns="2" Visibility="{Binding ShowHorizontalWheel, Converter={StaticResource BoolToVis}}">
                        <DockPanel Margin="0,3,20,3" ToolTip="可能来自可倾斜滚轮或触摸板驱动"><TextBlock DockPanel.Dock="Right" Text="{Binding WheelLeftText}"/><TextBlock Text="向左横向滚动" Style="{StaticResource SecondaryText}"/></DockPanel>
                        <DockPanel Margin="0,3" ToolTip="可能来自可倾斜滚轮或触摸板驱动"><TextBlock DockPanel.Dock="Right" Text="{Binding WheelRightText}"/><TextBlock Text="向右横向滚动" Style="{StaticResource SecondaryText}"/></DockPanel>
                    </UniformGrid>
                </StackPanel>
            </Grid>

            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="屏幕位置热力图" Style="{StaticResource SectionTitleText}" VerticalAlignment="Center"/>
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Margin="0,8,0,0">
                    <RadioButton Content="今天" GroupName="HeatmapRange" IsChecked="{Binding IsHeatmapTodayRange, Mode=TwoWay}"/>
                    <RadioButton Content="最近 7 天" GroupName="HeatmapRange" IsChecked="{Binding IsHeatmapLast7DaysRange, Mode=TwoWay}"/>
                    <RadioButton Content="最近 30 天" GroupName="HeatmapRange" IsChecked="{Binding IsHeatmapLast30DaysRange, Mode=TwoWay}"/>
                    <RadioButton Content="全部" GroupName="HeatmapRange" IsChecked="{Binding IsHeatmapAllRange, Mode=TwoWay}"/>
                    <Button Content="导出 PNG" Command="{Binding ExportHeatmapCommand}" Margin="4,0,0,0"
                            AutomationProperties.AutomationId="ExportHeatmapButton"/>
                </StackPanel>
            </Grid>
            <Border Style="{StaticResource SectionDivider}"/>
            <WrapPanel Margin="0,0,0,4">
                <StackPanel Margin="0,0,28,16">
                    <TextBlock Text="筛选" Style="{StaticResource FilterGroupLabel}"/>
                    <WrapPanel>
                        <ComboBox ItemsSource="{Binding MonitorOptions}"
                                  SelectedItem="{Binding SelectedMonitor}"
                                  DisplayMemberPath="Label"
                                  MinWidth="200"
                                  Margin="0,0,12,0"
                                  AutomationProperties.Name="显示器筛选"/>
                        <ComboBox ItemsSource="{Binding ButtonOptions}"
                                  SelectedItem="{Binding SelectedButton}"
                                  DisplayMemberPath="Label"
                                  MinWidth="140"
                                  AutomationProperties.Name="点击按键筛选"/>
                    </WrapPanel>
                </StackPanel>
                <StackPanel Margin="0,0,28,16">
                    <TextBlock Text="图层" Style="{StaticResource FilterGroupLabel}"/>
                    <WrapPanel>
                        <CheckBox Content="点击" Margin="0,0,20,0" IsChecked="{Binding ShowClickLayer, Mode=TwoWay}"/>
                        <CheckBox Content="轨迹" Margin="0,0,20,0" IsChecked="{Binding ShowTrajectoryLayer, Mode=TwoWay}"/>
                        <CheckBox Content="覆盖挑战" Margin="0" IsChecked="{Binding ShowCoverageLayer, Mode=TwoWay}"/>
                    </WrapPanel>
                </StackPanel>
                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="显示" Style="{StaticResource FilterGroupLabel}"/>
                    <WrapPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,28,0">
                            <TextBlock Text="强度" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <RadioButton Content="当前视图" GroupName="HeatmapIntensity" IsChecked="{Binding IsRelativeIntensity, Mode=TwoWay}"/>
                            <RadioButton Content="全局尺度" GroupName="HeatmapIntensity" Margin="0" IsChecked="{Binding IsGlobalIntensity, Mode=TwoWay}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="色阶" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <RadioButton Content="线性" GroupName="HeatmapScale" IsChecked="{Binding IsLinearScale, Mode=TwoWay}"/>
                            <RadioButton Content="对数" GroupName="HeatmapScale" Margin="0" IsChecked="{Binding IsLogarithmicScale, Mode=TwoWay}"/>
                        </StackPanel>
                    </WrapPanel>
                </StackPanel>
            </WrapPanel>
            <TextBlock Text="{Binding HeatmapLegendText}" Style="{StaticResource SecondaryText}"
                       TextWrapping="Wrap" Margin="0,0,0,14"/>
            <Border Style="{StaticResource SectionDivider}" Margin="0,0,0,14"/>
            <CheckBox Content="记录屏幕位置热力图"
                      IsChecked="{Binding ScreenPositionStatsEnabled, Mode=TwoWay}"/>
            <TextBlock Text="只保存本机坐标统计，不截屏，不记录窗口名称或输入内容。关闭后仍可查看已有数据。"
                       Style="{StaticResource SecondaryText}" Margin="22,0,0,12"/>
            <UniformGrid Columns="3" Margin="0,0,0,8">
                <StackPanel Margin="0,0,12,0" Visibility="{Binding ShowClickLayer, Converter={StaticResource BoolToVis}}"><TextBlock Text="点击位置" Style="{StaticResource SecondaryText}" Margin="0,0,0,6"/><Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" Background="{DynamicResource ContentBackgroundBrush}" Padding="4"><Image Source="{Binding ClickHeatmapImage}" Height="170" Stretch="Uniform"/></Border></StackPanel>
                <StackPanel Margin="0,0,12,0" Visibility="{Binding ShowTrajectoryLayer, Converter={StaticResource BoolToVis}}"><TextBlock Text="鼠标轨迹" Style="{StaticResource SecondaryText}" Margin="0,0,0,6"/><Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" Background="{DynamicResource ContentBackgroundBrush}" Padding="4"><Image Source="{Binding TrajectoryHeatmapImage}" Height="170" Stretch="Uniform"/></Border></StackPanel>
                <StackPanel Visibility="{Binding ShowCoverageLayer, Converter={StaticResource BoolToVis}}"><TextBlock Text="覆盖挑战" Style="{StaticResource SecondaryText}" Margin="0,0,0,6"/><Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" Background="{DynamicResource ContentBackgroundBrush}" Padding="4"><Image Source="{Binding CoverageHeatmapImage}" Height="170" Stretch="Uniform"/></Border></StackPanel>
            </UniformGrid>
            <TextBlock Text="{Binding CoverageText}" Style="{StaticResource SecondaryText}" Margin="0,2,0,20"/>
            <TextBlock Text="覆盖率按本地采样网格估算，表示光标中心路径经过的区域，不是逐物理像素精确覆盖，也不代表指针图形覆盖面积。"
                       Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,-14,0,8"/>
            <Button Content="重置累计覆盖" Command="{Binding ResetCoverageCommand}" HorizontalAlignment="Left" Margin="0,0,0,20"/>
            <TextBlock Text="{Binding ExportStatus}" Style="{StaticResource SecondaryText}" Margin="0,-14,0,20"/>

            <TextBlock Text="最近 7 天鼠标活动" Style="{StaticResource SectionTitleText}"/>
            <Border Style="{StaticResource SectionDivider}"/>
            <lvc:CartesianChart Height="176" Series="{Binding TrendSeries}" XAxes="{Binding TrendXAxes}"
                                YAxes="{Binding TrendYAxes}" LegendPosition="Hidden" TooltipPosition="Top"
                                ZoomMode="None" AnimationsSpeed="0:0:0" Background="Transparent"/>
            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                <TextBlock Text="{Binding DataStateText}" Style="{StaticResource SecondaryText}" VerticalAlignment="Center"/>
                <Button Content="刷新" Command="{Binding RetryCommand}" Margin="12,0,0,0"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
