<UserControl x:Class="KeyPulse.App.Views.ReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">
    <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
            <TextBlock Text="{Binding DataStateText}" Style="{StaticResource SecondaryText}" VerticalAlignment="Center"/>
            <Button Content="刷新" Command="{Binding RefreshCommand}" Margin="12,0,0,0"/>
        </StackPanel>
        <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{Binding RangeText}" Style="{StaticResource SecondaryText}"/>
                <TextBlock Text="按相同进度与上个同期公平对比" Style="{StaticResource SecondaryText}" FontSize="11" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ComboBox Width="148" ItemsSource="{Binding PeriodOptions}" SelectedItem="{Binding SelectedPeriod}"
                          DisplayMemberPath="Title" Margin="0,0,10,0"/>
                <Button Content="导出 PNG" Command="{Binding ExportPngCommand}"/>
                <Button Content="导出 HTML" Command="{Binding ExportHtmlCommand}" Margin="8,0,0,0"/>
            </StackPanel>
        </Grid>
        <ScrollViewer Style="{StaticResource PageScrollViewer}">
            <StackPanel>
                <UniformGrid Columns="4" Margin="0,0,0,20">
                    <StackPanel Margin="0,0,16,0"><TextBlock Text="{Binding EffectiveTimeText}" Style="{StaticResource MetricValue}" FontSize="24"/><TextBlock Text="有效使用" Style="{StaticResource MetricLabel}"/></StackPanel>
                    <StackPanel Margin="0,0,16,0"><TextBlock Text="{Binding SessionText}" Style="{StaticResource MetricValue}" FontSize="24"/><TextBlock Text="活动会话" Style="{StaticResource MetricLabel}"/></StackPanel>
                    <StackPanel Margin="0,0,16,0"><TextBlock Text="{Binding KeyText}" Style="{StaticResource MetricValue}" FontSize="24"/><TextBlock Text="按键" Style="{StaticResource MetricLabel}"/></StackPanel>
                    <StackPanel><TextBlock Text="{Binding ClickText}" Style="{StaticResource MetricValue}" FontSize="24"/><TextBlock Text="鼠标点击" Style="{StaticResource MetricLabel}"/></StackPanel>
                </UniformGrid>
                <Border Background="{DynamicResource ControlBackgroundBrush}" BorderBrush="{DynamicResource ControlBorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,20">
                    <TextBlock Text="{Binding ComparisonText}" Style="{StaticResource BodyText}"/>
                </Border>
                <TextBlock Text="活动变化" Style="{StaticResource SectionTitleText}"/>
                <Border Style="{StaticResource SectionDivider}"/>
                <lvc:CartesianChart Height="230" Series="{Binding ActivitySeries}" XAxes="{Binding XAxes}" YAxes="{Binding YAxes}"
                                    LegendPosition="Hidden" TooltipPosition="Top" ZoomMode="None" AnimationsSpeed="0:0:0" Background="Transparent"/>
                <TextBlock Text="本期摘要" Style="{StaticResource SectionTitleText}" Margin="0,20,0,0"/>
                <Border Style="{StaticResource SectionDivider}"/>
                <UniformGrid Columns="2">
                    <StackPanel Margin="0,0,20,0"><TextBlock Text="最常用按键" Style="{StaticResource SecondaryText}"/><TextBlock Text="{Binding TopKeyText}" Style="{StaticResource BodyText}"/></StackPanel>
                    <StackPanel><TextBlock Text="有效使用最长的应用" Style="{StaticResource SecondaryText}"/><TextBlock Text="{Binding TopAppText}" Style="{StaticResource BodyText}" TextWrapping="Wrap"/></StackPanel>
                </UniformGrid>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
