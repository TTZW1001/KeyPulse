<UserControl x:Class="KeyPulse.App.Views.KeyboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton Content="今天"
                             GroupName="KeyboardRange"
                             IsChecked="{Binding IsTodayRange, Mode=TwoWay}"
                             AutomationProperties.AutomationId="KeyboardToday"/>
                <RadioButton Content="最近 7 天"
                             GroupName="KeyboardRange"
                             IsChecked="{Binding IsLast7DaysRange, Mode=TwoWay}"
                             AutomationProperties.AutomationId="KeyboardLast7"/>
            </StackPanel>
            <TextBlock Text="按键热力图" Style="{StaticResource SecondaryText}" VerticalAlignment="Center"/>
        </DockPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="少" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ItemsControl ItemsSource="{Binding LegendFills}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="18" Height="10" Margin="1,0"
                                    Background="{Binding}"
                                    BorderBrush="{DynamicResource DividerBrush}"
                                    BorderThickness="1"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="多" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="8,0,0,0"/>
            </StackPanel>
            <TextBlock Text="Hover 显示键名和次数。未上图的键列在「其他」。"
                       Style="{StaticResource SecondaryText}"
                       VerticalAlignment="Center"/>
        </DockPanel>

        <DockPanel>
        <Grid DockPanel.Dock="Bottom" Margin="0,10,0,0" MaxHeight="96">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="160"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*" MinWidth="160"/>
            </Grid.ColumnDefinitions>
            <DockPanel Grid.Column="0" Visibility="{Binding HasTopKeys, Converter={StaticResource BoolToVis}}">
                <TextBlock DockPanel.Dock="Top" Text="最常用" Style="{StaticResource SecondaryText}" Margin="0,0,0,6"/>
                <ItemsControl ItemsSource="{Binding TopKeys}" AutomationProperties.AutomationId="TopKeys">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,2">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" Style="{StaticResource SecondaryText}"/>
                                <TextBlock Text="{Binding Name}" Style="{StaticResource BodyText}"/>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
            <DockPanel Grid.Column="2" Visibility="{Binding HasOtherKeys, Converter={StaticResource BoolToVis}}">
                <TextBlock DockPanel.Dock="Top" Text="其他按键" Style="{StaticResource SecondaryText}" Margin="0,0,0,6"/>
                <ItemsControl ItemsSource="{Binding OtherKeys}" AutomationProperties.AutomationId="OtherKeys">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,2">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" Style="{StaticResource SecondaryText}"/>
                                <TextBlock Text="{Binding Name}" Style="{StaticResource BodyText}"/>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Grid>

        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      AutomationProperties.AutomationId="HeatmapScroller">
            <ItemsControl ItemsSource="{Binding Keys}"
                          Width="{Binding CanvasWidth}"
                          Height="{Binding CanvasHeight}"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Top"
                          Margin="0,0,0,8"
                          AutomationProperties.AutomationId="Heatmap">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                        <Setter Property="Canvas.Top" Value="{Binding Top}"/>
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="{Binding Width}"
                                Height="{Binding Height}"
                                Background="{Binding Fill}"
                                BorderBrush="{DynamicResource DividerBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                SnapsToDevicePixels="True"
                                ToolTip="{Binding HoverText}"
                                ToolTipService.InitialShowDelay="200"
                                ToolTipService.ShowDuration="20000"
                                AutomationProperties.Name="{Binding HoverText}">
                            <TextBlock Text="{Binding Label}"
                                       FontSize="10"
                                       FontFamily="{DynamicResource AppFontFamily}"
                                       Foreground="{Binding LabelBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       TextAlignment="Center"/>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        </DockPanel>
    </DockPanel>
</UserControl>
