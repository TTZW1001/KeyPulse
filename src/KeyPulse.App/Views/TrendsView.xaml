<UserControl x:Class="KeyPulse.App.Views.TrendsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
            <TextBlock Text="{Binding DataStateText}" Style="{StaticResource SecondaryText}" VerticalAlignment="Center"/>
            <Button Content="刷新" Command="{Binding RetryCommand}" Margin="12,0,0,0"/>
        </StackPanel>
        <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0"
                       Text="{Binding RangeCaption}"
                       Style="{StaticResource SecondaryText}"
                       VerticalAlignment="Center"
                       AutomationProperties.AutomationId="TrendCaption"/>
            <ComboBox Grid.Row="0" Grid.Column="1"
                      Width="168"
                      ItemsSource="{Binding RangeOptions}"
                      SelectedItem="{Binding SelectedRange}"
                      DisplayMemberPath="Title"
                      VerticalAlignment="Center"
                      AutomationProperties.AutomationId="TrendRange">
                <ComboBox.ItemContainerStyle>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="AutomationProperties.AutomationId" Value="{Binding Kind}"/>
                    </Style>
                </ComboBox.ItemContainerStyle>
            </ComboBox>
            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,12,0,0"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsCustomRange, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="从" Style="{StaticResource SecondaryText}"
                           Margin="0,0,8,0" VerticalAlignment="Center"/>
                <DatePicker Width="152"
                            SelectedDate="{Binding CustomFromDate, Mode=TwoWay}"
                            SelectedDateFormat="Short"
                            AutomationProperties.Name="自定义开始日期"
                            AutomationProperties.AutomationId="TrendFrom"/>
                <TextBlock Text="至" Style="{StaticResource SecondaryText}"
                           Margin="12,0,8,0" VerticalAlignment="Center"/>
                <DatePicker Width="152"
                            SelectedDate="{Binding CustomToDate, Mode=TwoWay}"
                            SelectedDateFormat="Short"
                            AutomationProperties.Name="自定义结束日期"
                            AutomationProperties.AutomationId="TrendTo"/>
            </StackPanel>
        </Grid>
        <TextBlock DockPanel.Dock="Top"
                   Text="正在加载"
                   Style="{StaticResource SecondaryText}"
                   Margin="0,0,0,8"
                   Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                   AutomationProperties.AutomationId="TrendLoading"/>
        <ScrollViewer Style="{StaticResource PageScrollViewer}">
            <StackPanel>
                <TextBlock Text="键盘按键趋势" Style="{StaticResource SectionTitleText}"/>
                <Border Style="{StaticResource SectionDivider}"/>
                <lvc:CartesianChart Height="168"
                                    Margin="0,0,0,8"
                                    Series="{Binding KeySeries}"
                                    XAxes="{Binding KeyXAxes}"
                                    YAxes="{Binding KeyYAxes}"
                                    LegendPosition="Hidden"
                                    TooltipPosition="Top"
                                    ZoomMode="None"
                                    AnimationsSpeed="0:0:0"
                                    Background="Transparent"
                                    AutomationProperties.AutomationId="TrendKeysChart"/>

                <TextBlock Text="鼠标点击趋势" Style="{StaticResource SectionTitleText}" Margin="0,16,0,0"/>
                <Border Style="{StaticResource SectionDivider}"/>
                <lvc:CartesianChart Height="168"
                                    Margin="0,0,0,8"
                                    Series="{Binding ClickSeries}"
                                    XAxes="{Binding ClickXAxes}"
                                    YAxes="{Binding ClickYAxes}"
                                    LegendPosition="Hidden"
                                    TooltipPosition="Top"
                                    ZoomMode="None"
                                    AnimationsSpeed="0:0:0"
                                    Background="Transparent"
                                    AutomationProperties.AutomationId="TrendClicksChart"/>

                <TextBlock Text="滚轮趋势" Style="{StaticResource SectionTitleText}" Margin="0,16,0,0"/>
                <Border Style="{StaticResource SectionDivider}"/>
                <lvc:CartesianChart Height="168"
                                    Margin="0,0,0,8"
                                    Series="{Binding WheelSeries}"
                                    XAxes="{Binding WheelXAxes}"
                                    YAxes="{Binding WheelYAxes}"
                                    LegendPosition="Hidden"
                                    TooltipPosition="Top"
                                    ZoomMode="None"
                                    AnimationsSpeed="0:0:0"
                                    Background="Transparent"
                                    AutomationProperties.AutomationId="TrendWheelChart"/>

                <TextBlock Text="每小时活跃分布" Style="{StaticResource SectionTitleText}" Margin="0,16,0,0"/>
                <Border Style="{StaticResource SectionDivider}"/>
                <lvc:CartesianChart Height="168"
                                    Margin="0,0,0,8"
                                    Series="{Binding HourlySeries}"
                                    XAxes="{Binding HourlyXAxes}"
                                    YAxes="{Binding HourlyYAxes}"
                                    LegendPosition="Hidden"
                                    TooltipPosition="Top"
                                    ZoomMode="None"
                                    AnimationsSpeed="0:0:0"
                                    Background="Transparent"
                                    AutomationProperties.AutomationId="TrendHourlyChart"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
