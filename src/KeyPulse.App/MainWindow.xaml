<Window x:Class="KeyPulse.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KeyPulse"
        Width="720" Height="560"
        MinWidth="560" MinHeight="420"
        Background="#F7F7F5"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">
    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Top" HorizontalAlignment="Center">
            <Image Width="64" Height="64" Margin="0,0,0,16"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   Source="pack://application:,,,/Assets/logo.png"/>
            <TextBlock Text="{Binding Title}"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="#202020"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding PrivacyNotice}"
                       FontSize="14"
                       Margin="0,8,0,16"
                       Foreground="#707070"
                       HorizontalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                <Button x:Name="PauseButton"
                        Content="{Binding PauseLabel}"
                        Width="88"
                        Padding="8,4"
                        Command="{Binding TogglePauseCommand}"
                        AutomationProperties.AutomationId="PauseButton"/>
                <TextBlock Text="{Binding StatusText}"
                           Margin="16,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="#202020"
                           AutomationProperties.AutomationId="StatusText"/>
            </StackPanel>
        </StackPanel>
        <ScrollViewer>
            <TextBlock x:Name="StatsText"
                       Text="{Binding StatsText}"
                       FontFamily="Consolas, Cascadia Mono, Segoe UI"
                       FontSize="13"
                       Foreground="#202020"
                       TextWrapping="Wrap"
                       AutomationProperties.AutomationId="DebugStats"/>
        </ScrollViewer>
    </DockPanel>
</Window>
