<Window x:Class="KeyPulse.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KeyPulse"
        Width="720" Height="420"
        MinWidth="560" MinHeight="320"
        Background="#F7F7F5"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <Image Width="64" Height="64" Margin="0,0,0,20"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   Source="pack://application:,,,/Assets/logo.png"/>
            <TextBlock Text="{Binding Title}"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="#202020"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding PrivacyNotice}"
                       FontSize="14"
                       Margin="0,10,0,0"
                       Foreground="#707070"
                       HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>
